# Copie para .env (nunca commitar o .env real) e preencha os valores.

# --- Consulta CNPJ / Leitor de NF e Contratos ---
OPENAI_API_KEY=

# --- Banco de logs (Postgres local, container "db" do docker-compose) ---
# DATABASE_URL é montado automaticamente pelo docker-compose a partir desta senha,
# não precisa preencher DATABASE_URL aqui.
POSTGRES_PASSWORD=

# --- Login Microsoft Entra ID ---
# Reaproveita o MESMO App Registration já usado pelo CEDOC (backend/.env de lá:
# AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_CLIENT_SECRET) — copie os mesmos valores aqui.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# No Azure Portal, no MESMO App Registration, adicione este Redirect URI
# (tipo "Web") na lista de Redirect URIs, além dos que já existem para CEDOC/CockpitCIO:
#   https://portalcnpj.viaappia.com.br
AZURE_REDIRECT_URI=https://portalcnpj.viaappia.com.br
